<!DOCTYPE html>
<html>
<head>
    <title>Test Page</title>
    <meta charset="utf-h" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Simple.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/metisMenu/3.0.7/metisMenu.min.css" integrity="sha512-penLIHxUXUI3G5ttBrgoHMGK4vH+u6Wv8Mv17rP1u9q3zL7bvqLgK+K8syL0j27y6iH2w9KvmmXPMFmYJkG/A==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <style>
        /* Existing styles from the user's file */
        .navbar-brand {
            font-weight: bold;
        }
        /* More existing styles */

        /* Custom styles for vertical sidebar menu in ASP.NET Core View */
        #sigest-app-sidebar #sipe-app-menu.navbar-nav {
            flex-direction: column; /* Override Bootstrap's default row direction for navbar-nav */
            width: 100%;
        }

        #sigest-app-sidebar #sipe-app-menu.navbar-nav > .nav-item {
            width: 100%; /* Ensure nav items span the full width of the sidebar */
        }

        #sigest-app-sidebar #sipe-app-menu.navbar-nav > .nav-item > .nav-link {
            width: 100%; /* Ensure links also span full width for better clickability */
            box-sizing: border-box;
        }
    </style>
</head>
<body>
    <div id="sigest-app-sidebar" class="d-flex flex-column flex-shrink-0 p-3 text-white bg-dark" style="width: 280px;">
        <a href="/" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none">
            <span class="fs-4">SigeSimple</span>
        </a>
        <hr>
        <ul id="sipe-app-menu" class="nav nav-pills flex-column mb-auto navbar-nav">
            <li class="nav-item">
                <a href="#" class="nav-link active" aria-current="page">
                    Home
                </a>
            </li>
            <li>
                <a href="#" class="nav-link text-white">
                    Dashboard
                </a>
            </li>
            <li>
                <a href="#" class="nav-link text-white has-arrow">
                    Orders
                </a>
                <ul class="nav flex-column ms-3">
                    <li class="nav-item"><a class="nav-link text-white" href="#">New Order</a></li>
                    <li class="nav-item"><a class="nav-link text-white" href="#">View Orders</a></li>
                </ul>
            </li>
        </ul>
        <hr>
        <!-- User dropdown -->
    </div>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/metisMenu/3.0.7/metisMenu.min.js" integrity="sha512-XyR16UyXN/3zVWG54HIfQxY2N/bQnLPHN92Lz7jH4FfLpPIm3C3G/2i/n8C/G4o1K320ImTqLhRzYqP/v4A==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script type="text/javascript">
        $(document).ready(function () {
            $('#sipe-app-menu').metisMenu();
        });
    </script>
</body>
</html>
